{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run pyspelling",
            "type": "debugpy",
            "request": "launch",
            "program": "quality_control/spellcheck/check_spelling.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args":[
                "--root-dir", "../2026-2-level-labs-admin",
            ],
        },{
            "name": "Run fork update",
            "type": "debugpy",
            "request": "launch",
            "program": "quality_control/github/update_forks.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args":[
                "--config", "quality_control/github/update_fork_config.json",
            ],
        }
    ]
}
